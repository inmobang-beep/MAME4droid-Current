 void Config::Reload() {
+	// Beetle Game Room: keep what the command line asked for (--escape-exit,
+	// --pause-menu-exit); Android reloads the config once storage access is
+	// confirmed, which used to put these back to their defaults.
+	const bool pauseExits = bPauseExitsEmulator;
+	const bool pauseMenuExits = bPauseMenuExitsEmulator;
 	inReload_ = true;
 	Load();
 	inReload_ = false;
+	bPauseExitsEmulator = pauseExits;
+	bPauseMenuExitsEmulator = pauseMenuExits;
 }
 
